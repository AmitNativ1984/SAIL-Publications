@misc{huAdvancingSpikingNeural2023,
  title = {Advancing {{Spiking Neural Networks}} towards {{Deep Residual Learning}}},
  author = {Hu, Yifan and Deng, Lei and Wu, Yujie and Yao, Man and Li, Guoqi},
  year = 2023,
  month = mar,
  number = {arXiv:2112.08954},
  eprint = {2112.08954},
  primaryclass = {cs.NE},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2112.08954},
  urldate = {2026-10-21},
  abstract = {Despite the rapid progress of neuromorphic computing, inadequate capacity and insufficient representation power of spiking neural networks (SNNs) severely restrict their application scope in practice. Residual learning and shortcuts have been evidenced as an important approach for training deep neural networks, but rarely did previous work assess their applicability to the characteristics of spike-based communication and spatiotemporal dynamics. In this paper, we first identify that this negligence leads to impeded information flow and the accompanying degradation problem in previous residual SNNs. To address this issue, we propose a novel SNN-oriented residual architecture termed MS-ResNet, which establishes membrane-based shortcut pathways, and further prove that the gradient norm equality can be achieved in MS-ResNet by introducing block dynamical isometry theory, which ensures the network can be well-behaved in a depth-insensitive way. Thus we are able to significantly extend the depth of directly trained SNNs, e.g., up to 482 layers on CIFAR-10 and 104 layers on ImageNet, without observing any slight degradation problem. To validate the effectiveness of MS-ResNet, experiments on both frame-based and neuromorphic datasets are conducted. MS-ResNet104 achieves a superior result of 76.02\% accuracy on ImageNet, which is the highest to our best knowledge in the domain of directly trained SNNs. Great energy efficiency is also observed, with an average of only one spike per neuron needed to classify an input sample. We believe our powerful and scalable models will provide a strong support for further exploration of SNNs.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Computer Science - Neural and Evolutionary Computing},
  file = {/home/amit/snap/zotero-snap/common/Zotero/storage/N9JCW7G2/Hu et al. - 2023 - Advancing Spiking Neural Networks towards Deep Residual Learning.pdf;/home/amit/snap/zotero-snap/common/Zotero/storage/RU9BIVGN/2112.html}
}

@misc{huebotterSpikingNeuralNetworks2025a,
  title = {Spiking {{Neural Networks}} for {{Continuous Control}} via {{End}}-to-{{End Model-Based Learning}}},
  author = {Huebotter, Justus and Lanillos, Pablo and van Gerven, Marcel and Thill, Serge},
  year = 2025,
  month = sep,
  number = {arXiv:2509.05356},
  eprint = {2509.05356},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2509.05356},
  urldate = {2025-09-14},
  abstract = {Despite recent progress in training spiking neural networks (SNNs) for classification, their application to continuous motor control remains limited. Here, we demonstrate that fully spiking architectures can be trained end-to-end to control robotic arms with multiple degrees of freedom in continuous environments. Our predictive-control framework combines Leaky Integrate-and-Fire dynamics with surrogate gradients, jointly optimizing a forward model for dynamics prediction and a policy network for goal-directed action. We evaluate this approach on both a planar 2D reaching task and a simulated 6-DOF Franka Emika Panda robot. Results show that SNNs can achieve stable training and accurate torque control, establishing their viability for high-dimensional motor tasks. An extensive ablation study highlights the role of initialization, learnable time constants, and regularization in shaping training dynamics. We conclude that while stable and effective control can be achieved, recurrent spiking networks remain highly sensitive to hyperparameter settings, underscoring the importance of principled design choices.},
  archiveprefix = {arXiv},
  keywords = {.toread,Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Computer Science - Robotics,control,RL,SNN},
  file = {/home/amit/snap/zotero-snap/common/Zotero/storage/XRMMYELZ/Huebotter et al. - 2025 - Spiking Neural Networks for Continuous Control via End-to-End Model-Based Learning.pdf;/home/amit/snap/zotero-snap/common/Zotero/storage/Q2JV35QH/2509.html}
}

@misc{jiangBioinspiredVisualNavigation2026,
  title = {Towards Bio-Inspired Visual Navigation: A Neuromorphic Navigation Paradigm for {{MAVs}}},
  shorttitle = {Towards Bio-Inspired Visual Navigation},
  author = {Jiang, Junjie and Zhou, Ankang and Fang, Zheng},
  year = 2026,
  month = oct,
  number = {arXiv:2610.21978},
  eprint = {2610.21978},
  primaryclass = {cs.RO},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2610.21978},
  urldate = {2026-10-20},
  abstract = {Biological visual navigation achieves remarkable robustness at extremely low power, whereas frame-based robotic systems relying on artificial neural networks remain limited in both respects, particularly for energy-constrained micro aerial vehicles (MAVs) operating in complex environments. Inspired by the event-driven, sparse, and asynchronous principles of biological visual systems, neuromorphic sensing and computation provide a promising alternative for robust and energy-efficient navigation. In this paper, we propose the first end-to-end event-driven neuromorphic paradigm for MAV visual navigation in complex environments by integrating neuromorphic vision, spiking neural networks, and neuromorphic processors. The proposed method first extracts the environmental representation from event streams using a spiking perceptual representation module. This representation is fed into a spiking navigation module, where guidance learning and population coding enable efficient policy learning with few time steps. The navigation module then outputs a waypoint converted into executable trajectory points. Experiments show that the proposed neuromorphic method achieves navigation performance comparable to ANN-based methods while markedly reducing power consumption. The spiking perceptual module consumes only 19.57\% of the power of its ANN counterpart, while the spiking navigation module deployed on Intel Loihi consumes only 12.37\% of that required by its ANN counterpart running on NVIDIA Orin NX. Beyond prior neuromorphic systems focused mainly on relatively simple navigation subtasks, we demonstrate a complete neuromorphic visual navigation system spanning simulation and real-world deployment. Our results establish the feasibility of the neuromorphic paradigm for autonomous navigation and provide a bio-inspired pathway toward robust and low-power MAV navigation.},
  archiveprefix = {arXiv},
  keywords = {.toread,Computer Science - Robotics,Event Camera,impo,important,Important,Neuromophic,SNN},
  file = {/home/amit/snap/zotero-snap/common/Zotero/storage/39W2ZCRP/Jiang et al. - 2026 - Towards bio-inspired visual navigation a neuromorphic navigation paradigm for MAVs.pdf;/home/amit/snap/zotero-snap/common/Zotero/storage/M3X9XKRI/2610.html}
}

