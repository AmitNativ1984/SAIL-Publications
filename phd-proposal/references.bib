}

@misc{kulkarniReinforcementLearningCollisionfree2024,
  title = {Reinforcement {{Learning}} for {{Collision}}-Free {{Flight Exploiting Deep Collision Encoding}}},
  author = {Kulkarni, Mihir and Alexis, Kostas},
